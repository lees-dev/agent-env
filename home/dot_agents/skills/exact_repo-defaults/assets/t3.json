{
  "defaultThreadEnvMode": "worktree",
  "scripts": [
    {
      "name": "Agent setup",
      "command": "node -e \"process.argv.splice(1,0,require('path').join(require('os').homedir(),'.agents','bin','agent-worktree.mjs'));import(require('url').pathToFileURL(process.argv[1]).href)\" setup",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Agent teardown",
      "command": "node -e \"process.argv.splice(1,0,require('path').join(require('os').homedir(),'.agents','bin','agent-worktree.mjs'));import(require('url').pathToFileURL(process.argv[1]).href)\" teardown",
      "runOnWorktreeCreate": false,
      "runOnSettle": true
    }
  ]
}
