# .env.op is committed. It holds 1Password references and non-secret literals only.
# agent-worktree setup injects it into the gitignored .env.local (mode 0600); teardown deletes that file.
# One-off command with secrets: op run --env-file .env.op -- <command>
# Vault: agent-repos. Item: <repo>-<service>-<env>. Field label: the env var name. Tag: repo:<repo>.
# Add a credential: printf '%s' "$VALUE" | node "$HOME/.agents/bin/agent-secret.mjs" put <item> <ENV_NAME> --repo <repo> --env dev
# Production values never go here; they stay in the hosting or release system.
DATABASE_URL=op://agent-repos/<repo>-neon-dev/DATABASE_URL
AUTH_SECRET_KEY=op://agent-repos/<repo>-auth-dev/AUTH_SECRET_KEY
APP_NAME=example
