#!/bin/sh
# Git Bash on Windows only (other OSes ignore this file). The Muse installer puts muse.cmd in
# %LOCALAPPDATA%\Programs\muse, and bash does not run a .cmd by its bare name, so `muse`
# fails in Git Bash. This forwards to it. Managed by chezmoi from the agent-env repo.
# Deliberately outside ~/.local/bin: PowerShell and cmd would treat an extensionless file
# there as a document to open.
exec "$(cygpath -u "$LOCALAPPDATA")/Programs/muse/muse.cmd" "$@"
