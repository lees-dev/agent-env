{{- if eq .osFlavour "windows" -}}
{{- $pins := includeTemplate "packages/pins.json" . | fromJson -}}
{{- $optin := env "AGENT_ENV_SYSTEM_PACKAGES" | trim -}}
# packages 11 (Windows): tools from packages/winget.txt at their versions.toml pins, then
# Python 3.12 through uv.
# - Missing: `winget install --version <pin>`. Older than the pin: `winget upgrade --version`.
#   Newer than the pin: left alone (reported), so winget never downgrades a tool.
# - Per-machine installers (scope machine: Git, GitHub CLI, Node, Tailscale) raise a UAC
#   prompt, so they run only when the owner opted in for this apply:
#     $env:AGENT_ENV_SYSTEM_PACKAGES = '1'; chezmoi apply ...
#   The opt-in is rendered into this script, so turning it on later re-runs it.
# Run from a normal terminal, never from inside the Claude desktop app (MSIX redirect).
# role={{ .role }} machine={{ .machine }} optin={{ $optin | squote }}
# inputs: {{ include (joinPath .repoDir "versions.toml") | sha256sum }} {{ include (joinPath .repoDir "packages/winget.txt") | sha256sum }}
$ErrorActionPreference = 'Stop'
# dry-run={{ env "AGENT_ENV_DRY_RUN" | trim }} (rendered so that a dry run and a real run differ: chezmoi
# records each run_onchange_ script it ran, and a dry run must not stand in for the real one)
{{ template "packages/lib.ps1" . }}
Pk-AssertNotMsix
Pk-RefreshPath

$optin = {{ $optin | squote }}
$packageRole = {{ .role | squote }}
$items = @(
{{- range splitList "\n" (include (joinPath .repoDir "packages/winget.txt")) }}
{{-   $l := regexReplaceAll "#.*$" . "" | trim }}
{{-   if $l }}
{{-     $c := splitList "|" $l }}
{{-     if lt (len $c) 6 }}
{{-     $p := index $pins (printf "tools.%s" (index $c 1 | trim)) }}
{{-     $pin := $p.version }}
{{-     if hasKey $p "winget" }}{{ $pin = $p.winget }}{{ end }}
{{-     $probe := splitList " " (index $c 2 | trim) }}
    @{ Id = {{ index $c 0 | trim | squote }}; Name = {{ index $c 1 | trim | squote }}; Pin = {{ $pin | squote }}; ProbePin = {{ $p.version | squote }}; Exe = {{ first $probe | squote }}; Args = @({{ range $i, $a := rest $probe }}{{ if $i }}, {{ end }}{{ $a | squote }}{{ end }}); Scope = {{ index $c 3 | trim | squote }}; Match = {{ index $c 4 | trim | squote }} }
{{-     end }}
{{-   end }}
{{- end }}
)

{{ template "packages/winget-run.ps1" . }}

# Python 3.12 through uv (python.org has no Windows installer for 3.12 security releases).
$py312 = {{ (index $pins "tools.python312").minor | squote }}
if ($py312 -ne 'skip') {
    $exe = Join-Path $env:USERPROFILE ".local\bin\python$py312.exe"
    if (Test-Path -LiteralPath $exe) {
        Pk-Say ("python {0} (uv)" -f (Pk-Version $exe @('--version')))
    } elseif (Pk-Dry) {
        Pk-Say "dry-run: would uv python install $py312"
    } elseif (Get-Command uv -ErrorAction SilentlyContinue) {
        & uv python install $py312 2>&1 | Out-Null
        if ((Test-Path -LiteralPath $exe) -or $LASTEXITCODE -eq 0) { $script:PkChanged++; Pk-Say "python $py312 installed (uv)" }
        else { Pk-Fail "python$py312" "uv python install $py312 failed" }
    } else {
        Pk-Fail "python$py312" 'uv is not installed, so Python 3.12 was not installed'
    }
}

# Temurin's ADDLOCAL=ALL sets JAVA_HOME. Refresh it for subsequent scripts.
Pk-RefreshPath
Pk-Finish '11-packages-winget'
{{ end -}}
