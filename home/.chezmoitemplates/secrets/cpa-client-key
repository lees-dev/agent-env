{{- /*
  This machine's CLIProxyAPI client key: 1Password item cpa-client-<machine>, field credential.
  This is the only place the key is read (docs/cpa.md). Include it only from a private_ target
  or a run_ script (today: home/dot_config/agent-env/private_cpa-key.tmpl, and the two
  run_onchange_after_33-harness-muse-auth scripts, which embed only its SHA-256).
  Named cpa-client-key, not cpa-key, because .gitignore and scripts/secret-guard.sh reject any
  tracked file called cpa-key (that is what a plaintext key file was called on the old wiring).
  Test mode (.noSecrets, docs/testing.md): a fixed placeholder, op is never called, and a
  destination that is the real home directory stops the render.
*/ -}}
{{- if .noSecrets -}}
{{-   if eq (clean .chezmoi.destDir) (clean .chezmoi.homeDir) -}}
{{-     fail "noSecrets is for throwaway --destination tests only; re-run chezmoi init without AGENT_ENV_NO_SECRETS" -}}
{{-   end -}}
agent-env-no-secrets-placeholder
{{- else -}}
{{- onepasswordRead (printf "op://%s/%s/credential" .opVault .opCpaItem) | trim -}}
{{- end -}}
