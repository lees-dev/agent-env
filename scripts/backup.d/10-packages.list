# Shell startup files that run_onchange_before_10-packages-path adds the agent-env block to
# (WSL, Linux, macOS, and Git Bash on Windows). Relative to the home directory.
# The Windows user PATH is a registry value, not a file: that script saves its previous
# value as user-path-before-packages.txt in the latest ~/.agent-env-backups/<UTC timestamp>/.
.bashrc
.bash_profile
.bash_login
.profile
.zshrc
# Stable package launchers changed by scripts 12/14. Absent OS-specific paths are skipped.
.local/bin/mvn.cmd
.local/bin/t3code.cmd
.local/bin/t3code
.local/bin/jetbrains-toolbox
.local/bin/docker
.local/share/applications/t3code.desktop
.local/share/applications/jetbrains-toolbox.desktop
